<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Detective.Controls.DetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Detective.ViewModels">

    <UserControl.ContextFlyout>
        <MenuFlyout>
            <MenuFlyoutItem Text="Copy" Click="Copy_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.ContextFlyout>

    <!-- Task Manager layout: big live figures on the left, static key/value facts on the right. -->
    <ScrollViewer MaxHeight="{x:Bind vm:ChartWindow.Current.DetailsMaxHeight, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid ColumnSpacing="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <ItemsRepeater x:Name="LiveRepeater" VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="120" MinColumnSpacing="16" MinRowSpacing="10" ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:Stat">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource ChartCaptionStyle}" />
                            <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ItemsRepeater x:Name="StaticRepeater" Grid.Column="1" VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="3" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:Stat">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource ChartCaptionStyle}" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
    </ScrollViewer>
</UserControl>
