<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Detective.Views.CpuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Detective"
    xmlns:c="using:Detective.Controls"
    xmlns:vm="using:Detective.ViewModels">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Vm.Title, Mode=OneWay}" Style="{StaticResource FocusTitleStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.Subtitle, Mode=OneWay}" Style="{StaticResource FocusSubtitleStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Style="{StaticResource ChartCaptionStyle}" VerticalAlignment="Bottom">
                <Run Text="{x:Bind Caption(Vm.ShowLogical), Mode=OneWay}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged" MinWidth="170" FontSize="12">
                    <x:String>Overall utilization</x:String>
                    <x:String>Logical processors</x:String>
                </ComboBox>
                <TextBlock Text="100%" Style="{StaticResource ChartCaptionStyle}" VerticalAlignment="Bottom" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="Transparent">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutSubItem Text="Change graph to">
                        <RadioMenuFlyoutItem x:Name="OverallMenuItem" Text="Overall utilization" GroupName="CpuMode" Click="OverallMenu_Click" />
                        <RadioMenuFlyoutItem x:Name="LogicalMenuItem" Text="Logical processors" GroupName="CpuMode" Click="LogicalMenu_Click" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <c:AreaChart
                Primary="{x:Bind Vm.TileSeries, Mode=OneWay}"
                Accent="{x:Bind Vm.TileAccent, Mode=OneWay}"
                Visibility="{x:Bind local:Conv.Collapsed(Vm.ShowLogical), Mode=OneWay}" />
            <Grid x:Name="LogicalGrid" RowSpacing="4" ColumnSpacing="4" SizeChanged="LogicalGrid_SizeChanged"
                  Visibility="{x:Bind local:Conv.Visible(Vm.ShowLogical), Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock Text="{x:Bind vm:ChartWindow.Current.Caption, Mode=OneWay}" Style="{StaticResource ChartCaptionStyle}" />
            <TextBlock Text="0" Style="{StaticResource ChartCaptionStyle}" HorizontalAlignment="Right" />
        </Grid>

        <c:DetailsPanel Grid.Row="4" Margin="0,16,0,0"
            LiveStats="{x:Bind Vm.LiveStats, Mode=OneWay}"
            StaticInfo="{x:Bind Vm.StaticInfo, Mode=OneWay}" />
    </Grid>
</UserControl>
