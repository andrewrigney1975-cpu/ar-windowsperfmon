<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Detective.Views.ProcessesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Detective"
    xmlns:c="using:Detective.Controls"
    xmlns:vm="using:Detective.ViewModels">

    <UserControl.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource TileButtonStyle}">
            <Setter Property="Padding" Value="8,4,10,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HeaderTotalStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ChartCaptionStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SortGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <MenuFlyout x:Key="RowMenu">
            <MenuFlyoutItem Text="End task" Click="EndTask_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="End process tree" Click="EndTree_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Open file location" Click="OpenLocation_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, search and actions -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Processes" Style="{StaticResource FocusTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.CountText, Mode=OneWay}" Style="{StaticResource ChartCaptionStyle}"
                       VerticalAlignment="Center" Margin="4,4,0,0" />
            <HyperlinkButton Grid.Column="2" Content="Show network use" Click="RunAsAdmin_Click" VerticalAlignment="Center"
                             Visibility="{x:Bind ShowElevateLink(Vm.NetworkAvailable), Mode=OneWay}"
                             ToolTipService.ToolTip="Network use per process needs administrator rights. Restarts Detective as administrator." />
            <TextBox Grid.Column="3" x:Name="SearchBox" Width="220" PlaceholderText="Search by name or PID"
                     Text="{x:Bind Vm.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     AutomationProperties.Name="Search processes" />
            <Button Grid.Column="4" Content="End task" Click="EndTask_Click" IsEnabled="{x:Bind Vm.CanEnd, Mode=OneWay}"
                    ToolTipService.ToolTip="End the selected process (Delete)" VerticalAlignment="Center" />
            <Button Grid.Column="5" Content="End process tree" Click="EndTree_Click" IsEnabled="{x:Bind Vm.CanEnd, Mode=OneWay}"
                    ToolTipService.ToolTip="End the selected process and every process it started (Shift+Delete)" VerticalAlignment="Center" />
        </Grid>

        <InfoBar x:Name="Message" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <!-- Column headers: the column total over its name; click to sort, drag the left edge to resize. -->
        <Grid x:Name="HeaderGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Pid, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Cpu, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Memory, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Disk, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Network, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Gpu, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource HeaderButtonStyle}" Tag="Name" Click="Header_Click" AutomationProperties.Name="Sort by name">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <FontIcon x:Name="NameSort" Style="{StaticResource SortGlyphStyle}" />
                    <TextBlock Text="Name" Style="{StaticResource ChartCaptionStyle}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Tag="Pid" Click="Header_Click" AutomationProperties.Name="Sort by PID">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <FontIcon x:Name="PidSort" Style="{StaticResource SortGlyphStyle}" />
                    <TextBlock Text="PID" Style="{StaticResource HeaderLabelStyle}" />
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="PidSplitter" Grid.Column="1" />

            <Button Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" Tag="Cpu" Click="Header_Click" AutomationProperties.Name="Sort by CPU">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.CpuTotal, Mode=OneWay}" Style="{StaticResource HeaderTotalStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <FontIcon x:Name="CpuSort" Style="{StaticResource SortGlyphStyle}" />
                        <TextBlock Text="CPU" Style="{StaticResource HeaderLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="CpuSplitter" Grid.Column="2" />

            <Button Grid.Column="3" Style="{StaticResource HeaderButtonStyle}" Tag="Memory" Click="Header_Click" AutomationProperties.Name="Sort by memory">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.MemoryTotal, Mode=OneWay}" Style="{StaticResource HeaderTotalStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <FontIcon x:Name="MemorySort" Style="{StaticResource SortGlyphStyle}" />
                        <TextBlock Text="Memory" Style="{StaticResource HeaderLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="MemorySplitter" Grid.Column="3" />

            <Button Grid.Column="4" Style="{StaticResource HeaderButtonStyle}" Tag="Disk" Click="Header_Click" AutomationProperties.Name="Sort by disk"
                    ToolTipService.ToolTip="Bytes read and written per second. Counts all file I/O, so some network and device I/O is included.">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.DiskTotal, Mode=OneWay}" Style="{StaticResource HeaderTotalStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <FontIcon x:Name="DiskSort" Style="{StaticResource SortGlyphStyle}" />
                        <TextBlock Text="Disk" Style="{StaticResource HeaderLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="DiskSplitter" Grid.Column="4" />

            <Button x:Name="NetworkHeader" Grid.Column="5" Style="{StaticResource HeaderButtonStyle}" Tag="Network" Click="Header_Click" AutomationProperties.Name="Sort by network">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.NetworkTotal, Mode=OneWay}" Style="{StaticResource HeaderTotalStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <FontIcon x:Name="NetworkSort" Style="{StaticResource SortGlyphStyle}" />
                        <TextBlock Text="Network" Style="{StaticResource HeaderLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="NetworkSplitter" Grid.Column="5" />

            <Button Grid.Column="6" Style="{StaticResource HeaderButtonStyle}" Tag="Gpu" Click="Header_Click" AutomationProperties.Name="Sort by GPU"
                    ToolTipService.ToolTip="The busiest GPU engine the process uses">
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.GpuTotal, Mode=OneWay}" Style="{StaticResource HeaderTotalStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <FontIcon x:Name="GpuSort" Style="{StaticResource SortGlyphStyle}" />
                        <TextBlock Text="GPU" Style="{StaticResource HeaderLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <c:ColumnSplitter x:Name="GpuSplitter" Grid.Column="6" />
        </Grid>

        <!-- The table scrolls inside the focus area; the summary strip below stays put. -->
        <ListView
            x:Name="List"
            Grid.Row="3"
            SelectionMode="Single"
            SelectionChanged="List_SelectionChanged"
            ContextRequested="List_ContextRequested"
            PreviewKeyDown="List_PreviewKeyDown"
            AutomationProperties.Name="Processes"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Delete" Invoked="EndTask_Invoked" />
                <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="EndTree_Invoked" />
            </ListView.KeyboardAccelerators>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessRowVm">
                    <Grid Height="30" Background="Transparent" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Pid, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Cpu, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Memory, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Disk, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Network, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ProcessColumns.Current.Gpu, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="{x:Bind Indent, Mode=OneWay}">
                            <Button Width="28" Height="26" Padding="0" Margin="2,0,2,0" Background="Transparent" BorderThickness="0"
                                    Tag="{x:Bind}" Click="Expander_Click" IsTabStop="False"
                                    Opacity="{x:Bind local:Conv.Opacity(HasChildren), Mode=OneWay}"
                                    IsHitTestVisible="{x:Bind HasChildren, Mode=OneWay}"
                                    AutomationProperties.Name="Expand or collapse">
                                <FontIcon Glyph="{x:Bind local:Conv.Chevron(IsExpanded), Mode=OneWay}" FontSize="10" />
                            </Button>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontWeight="{x:Bind local:Conv.Weight(IsGroup)}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Pid, Mode=OneWay}" Style="{StaticResource CellTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Grid.Column="2" Background="{x:Bind local:Conv.CpuHeat(CpuHeat), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Cpu, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                        </Border>
                        <Border Grid.Column="3" Background="{x:Bind local:Conv.MemoryHeat(MemoryHeat), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Memory, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                        </Border>
                        <Border Grid.Column="4" Background="{x:Bind local:Conv.DiskHeat(DiskHeat), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Disk, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                        </Border>
                        <Border Grid.Column="5" Background="{x:Bind local:Conv.NetworkHeat(NetworkHeat), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Network, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                        </Border>
                        <Border Grid.Column="6" Background="{x:Bind local:Conv.GpuHeat(GpuHeat), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Gpu, Mode=OneWay}" Style="{StaticResource CellTextStyle}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
